{
  "name": "specwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && tsx src/studio/server.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.runtime.json",
    "start": "tsx src/studio/server.ts",
    "panel": "npm run build && tsx src/panel/cli.ts",
    "panel:start": "tsx src/panel/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:export": "tsx scripts/verify-export.ts",
    "mock": "tsx src/mock/cli.ts",
    "desktop:build": "npm run build && tsc -p tsconfig.desktop.json && node scripts/create-icon.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.json --win --x64 --publish never",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-desktop.ps1",
    "desktop:pack:dir": "npm run desktop:build && electron-builder --config electron-builder.json --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "dist/desktop/desktop/main.js",
  "description": "Local OpenAPI to standalone MCP server builder",
  "author": "Orkun Kocatürk",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Gatewaylabsnet/Specwake"
}
